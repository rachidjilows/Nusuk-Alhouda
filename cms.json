{
  "backend": {
    "name": "gitlab",
    "branch": "main",
    "auth_type": "pkce"
  },
  "local_backend": true,
  "media_folder": "public/media",
  "public_folder": "/media",
  "locale": "de",
  "collections": [
    {
      "name": "offers",
      "label": "Reiseangebote · Séjours",
      "folder": "src/content/offers",
      "create": true,
      "slug": "{{fields.slug}}",
      "identifier_field": "title",
      "fields": [
        {
          "name": "title",
          "label": "Interner Titel",
          "widget": "string"
        },
        {
          "name": "slug",
          "label": "Web-Adresse (kurzer Name)",
          "widget": "string",
          "pattern": [
            "^[a-z0-9]+(-[a-z0-9]+)*$",
            "z. B. omra-ramadan-2027"
          ]
        },
        {
          "name": "name",
          "label": "Titel",
          "widget": "object",
          "fields": [
            {
              "name": "ar",
              "label": "العربية",
              "widget": "string"
            },
            {
              "name": "fr",
              "label": "Français",
              "widget": "string"
            }
          ]
        },
        {
          "name": "summary",
          "label": "Kurzbeschreibung",
          "widget": "object",
          "fields": [
            {
              "name": "ar",
              "label": "العربية",
              "widget": "string"
            },
            {
              "name": "fr",
              "label": "Français",
              "widget": "string"
            }
          ]
        },
        {
          "name": "type",
          "label": "Reiseart",
          "widget": "object",
          "fields": [
            {
              "name": "ar",
              "label": "العربية",
              "widget": "string"
            },
            {
              "name": "fr",
              "label": "Français",
              "widget": "string"
            }
          ]
        },
        {
          "name": "start",
          "label": "Anreise",
          "widget": "datetime",
          "date_format": "YYYY-MM-DD",
          "time_format": false,
          "format": "YYYY-MM-DD"
        },
        {
          "name": "end",
          "label": "Abreise",
          "widget": "datetime",
          "date_format": "YYYY-MM-DD",
          "time_format": false,
          "format": "YYYY-MM-DD"
        },
        {
          "name": "days",
          "label": "Dauer in Tagen",
          "widget": "number",
          "value_type": "int",
          "min": 1
        },
        {
          "name": "photo",
          "label": "Titelbild",
          "widget": "image"
        },
        {
          "name": "hijri",
          "label": "Islamischer Kalender",
          "widget": "object",
          "required": false,
          "fields": [
            {
              "name": "ar",
              "label": "العربية",
              "widget": "string",
              "required": false
            },
            {
              "name": "fr",
              "label": "Français",
              "widget": "string",
              "required": false
            }
          ]
        },
        {
          "name": "flyer",
          "label": "Flyer",
          "widget": "image",
          "required": false
        },
        {
          "name": "hotels",
          "label": "Hoteltarife pro Person (MAD)",
          "widget": "list",
          "min": 1,
          "fields": [
            {
              "name": "label",
              "label": "Hotels Mekka / Medina",
              "widget": "object",
              "fields": [
                {
                  "name": "ar",
                  "label": "العربية",
                  "widget": "string"
                },
                {
                  "name": "fr",
                  "label": "Français",
                  "widget": "string"
                }
              ]
            },
            {
              "name": "double",
              "label": "2-Bett-Zimmer",
              "widget": "number",
              "value_type": "int",
              "min": 1
            },
            {
              "name": "triple",
              "label": "3-Bett-Zimmer",
              "widget": "number",
              "value_type": "int",
              "min": 1
            },
            {
              "name": "quad",
              "label": "4-Bett-Zimmer",
              "widget": "number",
              "value_type": "int",
              "min": 1
            },
            {
              "name": "five",
              "label": "5-Bett-Zimmer",
              "widget": "number",
              "value_type": "int",
              "min": 1
            }
          ],
          "summary": "{{fields.label.fr}}"
        },
        {
          "name": "included",
          "label": "Inklusive",
          "widget": "list",
          "required": false,
          "fields": [
            {
              "name": "ar",
              "label": "العربية",
              "widget": "string"
            },
            {
              "name": "fr",
              "label": "Français",
              "widget": "string"
            }
          ]
        },
        {
          "name": "excluded",
          "label": "Exklusive",
          "widget": "list",
          "required": false,
          "fields": [
            {
              "name": "ar",
              "label": "العربية",
              "widget": "string"
            },
            {
              "name": "fr",
              "label": "Français",
              "widget": "string"
            }
          ]
        },
        {
          "name": "schedule",
          "label": "Tagesprogramm (Tag und Beschreibung)",
          "widget": "list",
          "required": false,
          "fields": [
            {
              "name": "ar",
              "label": "العربية",
              "widget": "string"
            },
            {
              "name": "fr",
              "label": "Français",
              "widget": "string"
            }
          ]
        }
      ]
    },
    {
      "name": "guides_ar",
      "label": "Ratgeber ar",
      "folder": "src/content/guides/ar",
      "create": true,
      "slug": "{{slug}}",
      "fields": [
        {
          "name": "title",
          "label": "Titel",
          "widget": "string"
        },
        {
          "name": "summary",
          "label": "Kurzbeschreibung",
          "widget": "string"
        },
        {
          "name": "body",
          "label": "Inhalt",
          "widget": "markdown"
        }
      ]
    },
    {
      "name": "pages_ar",
      "label": "Agentur & Recht ar",
      "files": [
        {
          "name": "about",
          "label": "وكالتكم في الدار البيضاء",
          "file": "src/content/pages/ar/about.md",
          "fields": [
            {
              "name": "title",
              "label": "Titel",
              "widget": "string"
            },
            {
              "name": "body",
              "label": "Inhalt",
              "widget": "markdown"
            }
          ]
        },
        {
          "name": "imprint",
          "label": "البيانات القانونية",
          "file": "src/content/pages/ar/imprint.md",
          "fields": [
            {
