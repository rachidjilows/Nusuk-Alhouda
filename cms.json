              "widget": "string"
            },
            {
              "name": "body",
              "label": "Inhalt",
              "widget": "markdown"
            }
          ]
        },
        {
          "name": "privacy",
          "label": "سياسة الخصوصية",
          "file": "src/content/pages/ar/privacy.md",
          "fields": [
            {
              "name": "title",
              "label": "Titel",
              "widget": "string"
            },
            {
              "name": "body",
              "label": "Inhalt",
              "widget": "markdown"
            }
          ]
        },
        {
          "name": "terms",
          "label": "شروط الاستخدام",
          "file": "src/content/pages/ar/terms.md",
          "fields": [
            {
              "name": "title",
              "label": "Titel",
              "widget": "string"
            },
            {
              "name": "body",
              "label": "Inhalt",
              "widget": "markdown"
            }
          ]
        }
      ]
    },
    {
      "name": "guides_fr",
      "label": "Ratgeber fr",
      "folder": "src/content/guides/fr",
      "create": true,
      "slug": "{{slug}}",
      "fields": [
        {
          "name": "title",
          "label": "Titel",
          "widget": "string"
        },
        {
          "name": "summary",
          "label": "Kurzbeschreibung",
          "widget": "string"
        },
        {
          "name": "body",
          "label": "Inhalt",
          "widget": "markdown"
        }
      ]
    },
    {
      "name": "pages_fr",
      "label": "Agentur & Recht fr",
      "files": [
        {
          "name": "about",
          "label": "Votre agence à Casablanca",
          "file": "src/content/pages/fr/about.md",
          "fields": [
            {
              "name": "title",
              "label": "Titel",
              "widget": "string"
            },
            {
              "name": "body",
              "label": "Inhalt",
              "widget": "markdown"
            }
          ]
        },
        {
          "name": "imprint",
          "label": "Mentions légales",
          "file": "src/content/pages/fr/imprint.md",
          "fields": [
            {
              "name": "title",
              "label": "Titel",
              "widget": "string"
            },
            {
              "name": "body",
              "label": "Inhalt",
              "widget": "markdown"
            }
          ]
        },
        {
          "name": "privacy",
          "label": "Politique de confidentialité",
          "file": "src/content/pages/fr/privacy.md",
          "fields": [
            {
              "name": "title",
              "label": "Titel",
              "widget": "string"
            },
            {
              "name": "body",
              "label": "Inhalt",
              "widget": "markdown"
            }
          ]
        },
        {
          "name": "terms",
          "label": "Conditions d’utilisation",
          "file": "src/content/pages/fr/terms.md",
          "fields": [
            {
              "name": "title",
              "label": "Titel",
              "widget": "string"
            },
            {
              "name": "body",
              "label": "Inhalt",
              "widget": "markdown"
            }
          ]
        }
      ]
    },
    {
      "name": "reviews",
      "label": "Kundenstimmen",
      "files": [
        {
          "name": "voices",
          "label": "Freigegebene Stimmen",
          "file": "src/content/reviews.json",
          "fields": [
            {
              "name": "items",
              "label": "Stimmen",
              "widget": "list",
              "fields": [
                {
                  "name": "author",
                  "label": "Anzeigename",
                  "widget": "string"
                },
                {
                  "name": "quote",
                  "label": "Zitat",
                  "widget": "object",
                  "fields": [
                    {
                      "name": "ar",
                      "label": "العربية",
                      "widget": "string"
                    },
                    {
                      "name": "fr",
                      "label": "Français",
                      "widget": "string"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "home",
      "label": "Startseiten & FAQ",
      "files": [
        {
          "name": "home_ar",
          "label": "Startseite & FAQ ar",
          "file": "src/content/home-ar.json",
          "fields": [
            {
              "name": "hero",
              "label": "Titel",
              "widget": "string"
            },
            {
              "name": "intro",
              "label": "Einleitung",
              "widget": "string"
            },
            {
              "name": "why",
              "label": "Warum wir?",
              "widget": "string"
            },
            {
              "name": "whyText",
              "label": "Beschreibung",
              "widget": "string"
            },
            {
              "name": "faq",
              "label": "Häufige Fragen",
              "widget": "list",
              "fields": [
                {
                  "name": "question",
                  "label": "Frage",
                  "widget": "string"
                },
                {
                  "name": "answer",
                  "label": "Antwort",
                  "widget": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "home_fr",
          "label": "Startseite & FAQ fr",
          "file": "src/content/home-fr.json",
          "fields": [
            {
              "name": "hero",
              "label": "Titel",
              "widget": "string"
            },
            {
              "name": "intro",
              "label": "Einleitung",
              "widget": "string"
            },
            {
              "name": "why",
              "label": "Warum wir?",
              "widget": "string"
            },
            {
              "name": "whyText",
              "label": "Beschreibung",
              "widget": "string"
            },
            {
              "name": "faq",
              "label": "Häufige Fragen",
              "widget": "list",
              "fields": [
                {
                  "name": "question",
