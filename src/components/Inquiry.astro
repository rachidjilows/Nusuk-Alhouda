---
import { dict, offers, email, wa, url, type Lang } from "../lib/site";
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];
const key = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<div class="panel">
  <h2>{t.contact}</h2>
  <form data-inquiry data-success={t.success} data-error={t.error}>
    <input type="hidden" name="lang" value={lang} />
    <label>
      {t.program}
      <select name="program">
        <option value="">{t.general}</option>
        {offers.map((o) => (
          <option value={o.slug}>{o.name[lang]}</option>
        ))}
      </select>
    </label>
    <label>
      {t.name}
      <input name="name" autocomplete="name" required maxlength="100" />
    </label>
    <label>
      {t.email}
      <input
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="254"
        dir="ltr"
      />
    </label>
    <label>
      {t.message}
      <textarea name="message" rows="4" required maxlength="2500"></textarea>
    </label>
    <label>
      <input type="checkbox" name="consent" required /> {t.agree}
    </label>
    <a class="textlink" href={url(lang, "privacy")}>
      {t.privacy}
    </a>
    {key ? (
      <div
        class="cf-turnstile"
        data-sitekey={key}
        data-action="inquiry"
        data-language={lang}
      ></div>
    ) : (
      <p>
        {t.offline}{" "}
        <a class="textlink" href={wa}>
          WhatsApp
        </a>{" "}
        ·{" "}
        <a class="textlink" href={"mailto:" + email}>
          {email}
        </a>
      </p>
    )}
    <div class="actions">
      <button class="btn" disabled={!key}>
        {t.send}
      </button>
    </div>
    <p role="status" aria-live="polite"></p>
  </form>
</div>
{key && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>
)}
<script is:inline defer src="/inquiry.js"></script>
